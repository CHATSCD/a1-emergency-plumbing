# Canonical site URL — used for canonical tags, sitemap, robots and schema.org url.
NEXT_PUBLIC_SITE_URL=https://www.a1emergencyplumbingrepair.com

# Optional: persist "Request Service" form leads to Supabase.
# Table: public.service_requests (insert-only RLS policy).
# If these are unset, submissions are accepted and logged instead of stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
